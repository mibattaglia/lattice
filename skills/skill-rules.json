{
  "version": "1.0",
  "description": "Lattice skills activation triggers",
  "skills": {
    "lattice": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Lattice architecture: Interactor, Feature, ViewModel, @FeatureState, effects",
      "promptTriggers": {
        "keywords": ["lattice", "interactor", "viewmodel", "feature state", "effects", "scope", "scopedviewmodel"],
        "intentPatterns": ["(build|create|design).*?(feature|interactor|view model)", "(scope|compose).*?(view|child)"]
      },
      "fileTriggers": {
        "pathPatterns": ["Sources/Lattice/**"],
        "contentPatterns": ["@Interactor", "ViewModel", "FeatureState", "ScopedViewModel", "effects\\.perform"]
      }
    },
    "lattice-case-paths": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "medium",
      "description": "CasePaths ergonomics for Lattice actions and feature state",
      "promptTriggers": {
        "keywords": ["case paths", "casepathable", "case path", "enum", "associated value", "scopeifactive", "enum scoping"],
        "intentPatterns": ["(bind|extract|embed|scope).*?case"]
      },
      "fileTriggers": {
        "pathPatterns": ["Sources/**"],
        "contentPatterns": ["CasePathable", "AnyCasePath", "\\.sending\\(", "scopeIfActive"]
      }
    },
    "lattice-modern-swiftui": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "medium",
      "description": "SwiftUI with Lattice ViewModel and @Bindable",
      "promptTriggers": {
        "keywords": ["swiftui", "view", "@bindable", "sendviewevent", "scoped view", "child view"],
        "intentPatterns": ["(build|wire|connect|scope).*?(swiftui|view)"]
      },
      "fileTriggers": {
        "pathPatterns": ["Sources/Lattice/Presentation/**"],
        "contentPatterns": ["@Bindable", "sendViewEvent", "ViewModel", "ScopedViewModel"]
      }
    },
    "lattice-observable-models": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "low",
      "description": "Use @Observable for UI-only state; Interactor for domain logic",
      "promptTriggers": {
        "keywords": ["@observable", "observable", "model", "state"],
        "intentPatterns": ["(move|extract).*?(logic|state).*?(model)"]
      },
      "fileTriggers": {
        "pathPatterns": ["Sources/**"],
        "contentPatterns": ["@Observable", "FeatureState"]
      }
    },
    "lattice-testing": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Testing Lattice features with snapshot-diff TestViewModel and TestClock",
      "promptTriggers": {
        "keywords": ["test", "testviewmodel", "testeventtask", "testclock", "exhaustivity"],
        "intentPatterns": ["(test|assert|verify).*?(feature|view model|interactor|effect)"]
      },
      "fileTriggers": {
        "pathPatterns": ["Tests/**"],
        "contentPatterns": ["TestViewModel", "TestEventTask", "TestClock", "skipPendingCommits", "expect\\(", "receive\\("]
      }
    }
  }
}
