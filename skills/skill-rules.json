{
  "version": "1.0",
  "description": "Lattice skills activation triggers",
  "skills": {
    "lattice": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Lattice architecture: Interactor, Effects, @EffectID, Feature, ViewModel, ActorModel, FeatureState, @Domain, ViewState projection",
      "promptTriggers": {
        "keywords": ["lattice", "interactor", "viewmodel", "actormodel", "featurestate", "feature state", "@domain", "viewstate projection", "effects", "effectid", "debounce", "scope", "scopedviewmodel"],
        "intentPatterns": ["(build|create|design).*?(feature|interactor|view model)", "(scope|compose).*?(view|child)"]
      },
      "fileTriggers": {
        "pathPatterns": ["Sources/Lattice/**"],
        "contentPatterns": ["@Interactor", "ViewModel", "ActorModel", "@FeatureState", "@Domain", "@EffectID", "effects\\.perform", "effects\\.modify", "ScopedViewModel"]
      }
    },
    "lattice-case-paths": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "medium",
      "description": "CasePaths ergonomics for Lattice actions, enum states and their ViewState mirrors",
      "promptTriggers": {
        "keywords": ["case paths", "casepathable", "case path", "enum", "associated value", "scopeifactive", "enum scoping"],
        "intentPatterns": ["(bind|extract|embed|scope).*?case"]
      },
      "fileTriggers": {
        "pathPatterns": ["Sources/**"],
        "contentPatterns": ["CasePathable", "AnyCasePath", "\\.sending\\(", "scopeIfActive"]
      }
    },
    "lattice-modern-swiftui": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "medium",
      "description": "SwiftUI with Lattice ViewModel, @Bindable, and the task sendViewEvent returns",
      "promptTriggers": {
        "keywords": ["swiftui", "view", "@bindable", "sendviewevent", "refreshable", "task cancellation", "scoped view", "child view"],
        "intentPatterns": ["(build|wire|connect|scope).*?(swiftui|view)"]
      },
      "fileTriggers": {
        "pathPatterns": ["Sources/Lattice/Presentation/**"],
        "contentPatterns": ["@Bindable", "sendViewEvent", "ViewModel", "ScopedViewModel"]
      }
    },
    "lattice-observable-models": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "low",
      "description": "Use @Observable for UI-only state; Interactor for domain logic",
      "promptTriggers": {
        "keywords": ["@observable", "observable", "model", "state"],
        "intentPatterns": ["(move|extract).*?(logic|state).*?(model)"]
      },
      "fileTriggers": {
        "pathPatterns": ["Sources/**"],
        "contentPatterns": ["@Observable", "@FeatureState"]
      }
    },
    "lattice-testing": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Testing Lattice features with TestModel, TestViewModel, exhaustivity, and a gate clock",
      "promptTriggers": {
        "keywords": ["test", "testmodel", "testviewmodel", "testclock", "gateclock", "gate clock", "exhaustivity"],
        "intentPatterns": ["(test|assert|verify).*?(feature|view model|interactor|effect)"]
      },
      "fileTriggers": {
        "pathPatterns": ["Tests/**"],
        "contentPatterns": ["TestModel", "TestViewModel", "TestClock", "GateClock", "skipReceived", "skipInFlightEffects", "receive\\(", "expect\\s*\\{"]
      }
    }
  }
}
